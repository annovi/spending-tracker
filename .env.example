# AI Provider Configuration
# Choose which AI provider to use: "openai" or "claude"
AI_PROVIDER=openai

# OpenAI API key for transaction categorization (optional if using Claude)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Claude API key for transaction categorization (optional if using OpenAI)
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# Database URL (for running backend outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spending_tracker
