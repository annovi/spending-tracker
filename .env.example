# Copy to `.env` in the repo root for Docker Compose, or copy to `backend/.env` for local backend.
# PostgreSQL: use port 5433 when connecting from the host to the DB container (see docker-compose.yml).
# Use 5432 for a Postgres instance on the default local port (no Docker / native install).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/spending_tracker

# AI Provider Configuration — choose "openai" or "claude"
AI_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# CORS (comma-separated origins; Docker frontend is usually :3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google Sheets / Drive (optional) — path to service account JSON, or one-line JSON
# GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=
